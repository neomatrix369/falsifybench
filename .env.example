# Local-only live mode (npm run dev). Copy to .env, which is gitignored, and fill in.
# Never prefix these with VITE_: the browser must never see the key.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=
# Optional. Point at a stub (npm run stub:anthropic → http://127.0.0.1:8788) to run without a key or network.
ANTHROPIC_BASE_URL=
# Optional. Local server port (default 8787); the Vite proxy reads the same variable.
FALSIFYBENCH_SERVER_PORT=
