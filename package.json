{
  "name": "falsifybench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node tools/check-deps.mjs",
    "dev": "node tools/dev-live.mjs",
    "dev:live": "node tools/dev-live.mjs",
    "dev:vite": "vite",
    "prebuild": "npm run score:check",
    "build": "tsc -b && vite build",
    "postbuild": "node tools/check-dist-secrets.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "score": "vite-node tools/score/score.ts",
    "score:check": "node tools/score/check.mjs",
    "stub:anthropic": "vite-node server/stub/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "lucide-react": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
